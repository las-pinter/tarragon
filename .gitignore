# Rust build output
/target/
**/*.rs.bk

# Legacy application source still on disk
/src/
/scripts/

# Fixture corpus is tracked. Caches are ignored by the rules below.
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
/dist/
*.log

# The downloaded PSD corpus is never committed; only its fetch script is.
/tests/psd-corpus/*
!/tests/psd-corpus/fetch.sh
